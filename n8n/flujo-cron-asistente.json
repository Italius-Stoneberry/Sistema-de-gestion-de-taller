{
  "name": "Taller — Resumen programado (cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,22 * * *"
            }
          ]
        }
      },
      "id": "sch",
      "name": "9:00 y 22:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Números que reciben el resumen (con código de país, sin @c.us)\nconst numeros = [\"5492616828285\", \"5492615077088\", \"5492615080380\", \"5492614681780\"];\nreturn numeros.map((n) => ({ json: { numero: n } }));"
      },
      "id": "nu",
      "name": "Números",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3000/api/asistente/nudge?to={{ $json.numero }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "PEGA_TU_INGEST_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "Pedir_resumen",
      "name": "Pedir resumen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "hay-pendiente",
              "leftValue": "={{ $json.hay }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "hay_algo",
      "name": "¿Hay algo pendiente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:3001/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "PEGA_TU_WAHA_API_KEY"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: \"default\", chatId: $(\"Números\").item.json.numero + \"@c.us\", text: $json.reply }) }}"
      },
      "id": "Enviar_resumen",
      "name": "Enviar resumen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        220
      ]
    },
    {
      "parameters": {},
      "id": "sin_novedad",
      "name": "Todo al día (no manda nada)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        400
      ]
    }
  ],
  "connections": {
    "9:00 y 22:00": {
      "main": [
        [
          {
            "node": "Números",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Números": {
      "main": [
        [
          {
            "node": "Pedir resumen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pedir resumen": {
      "main": [
        [
          {
            "node": "¿Hay algo pendiente?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay algo pendiente?": {
      "main": [
        [
          {
            "node": "Enviar resumen",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Todo al día (no manda nada)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
